# Server-only — used by the Vite dev proxy, never bundled into the client
API_PROXY_TARGET=https://your-api.execute-api.region.amazonaws.com/stage/link-organizer
AI_PROXY_TARGET=http://localhost:4000

# Client paths — relative URLs only (no AWS hostname in the browser bundle)
VITE_API_BASE=/api
VITE_AI_API_BASE=/ai-api

# Set to true after uploading backend/function.zip to Lambda (Handler: handler.handler)
VITE_LOAD_FROM_API=true
